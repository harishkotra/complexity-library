# Public browser endpoint for the FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
ANALYSIS_CONFIDENCE_THRESHOLD=0.85
MAX_CODE_CHARACTERS=20000

# Set LLM_ENABLED only after configuring an Agno provider. Deterministic analysis works with false.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Planned service integrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
